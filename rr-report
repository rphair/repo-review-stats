#!/usr/bin/env bash

# rphair Wed 29 Jul 2026 20:56:38 EDT = baseline version (proof of concept)

# Visualised for cardano-foundation/CIPs GitHub repo: but should work anywhere.

# PREREQUISITES
# - a UNIX-like environment, in terms of shell & filename references.

# INPUT (stdin): in the same formast as this file generated by companion "collect" script:
# reviewList=reviews.txt

# OUTPUT (stdout): in Markdown to standard output, two tables:
# 1) number of reviews for each user (i.e. one for each line of that file; even if 0 size)
# 2) total size of all reviews for each user (zero-size reviews don't count towards this)
# ... with each figure also expressed as a percentage of the total (reviews *or* characters)

# HINT for report subsets (until perhaps this script grows in flexibility):
# - To see the impact of a certain subset of users (as well as from *everybody else):
# --- Divide ALL lines of $reviewList into 2 files of mutually exclusive entries:
# ------ one containing lines for a set of users (e.g. `grep` for these)
# ------ one containing all lines *not* for those users (e.g. `grep -v`)
# --- and run the report on each file separately.
# - (e.g. for CIP repo: measure for CIP editors and then everybody *except* CIP editors)

# HINT to report on a certain span of time: delete everything before and/or after that span.
# - This generally works because the "collect" script produces a sorted file.

# Part 1 of 2: accumulate totals for each user (count = 1 per review, size = sum of all lengths)

# Input lines have 4 fields of the form, of which we only care about 2nd & 3rd fields (0 base):
# 2026-07-24T14:57:49Z GNP1-dev 1917 https://github.com/cardano-foundation/CIPs/pull/1230#issuecomment-5071241691

IFS=' '                # to break input lines on the space character
declare -A size count  # to use them as associative arrays
while read -a fields   # -a: break lines into an array to grab fields from
do
  user=${fields[1]}
  length=${fields[2]}
  ((totalSize += length))
  ((totalCount += 1))
  # maths can be awkward in `bash`... maybe write this filter/accumulator also in `jq`?
  size["$user"]=`expr ${size["$user"]} + $length`
  count["$user"]=`expr ${count["$user"]} + 1`
done

# Part 2 of 2:
# For each report: output all lines to single variable, append TOTAL, then `sort` to stdout.
# NOTE the set of associate array keys for `count` and `size` should be identical;
#  however their order is non-deterministic so we might as well loop them separately:

bcScale=3   # used for decimal places of percentages; i.e. 2 less than *total* precision

# 2a) Total SIZE of all reviews for each user
echo '| ***user*** | ***review SIZE*** | ***percentage*** |'
echo '| --- | --- | --- |'
for user in ${!size[@]}
do
  userSize=${size[$user]}
  percent=`echo scale=${bcScale}";" $userSize "*" 100 / $totalSize | bc`"%"
  echo '|' $user '|' ${size[$user]} '|' $percent '|'
done | sort -rnk4   # descending numerically by 4th field = integer size

echo

# 2b) Total COUNT of reviews for each user
echo '| ***user*** | ***review COUNT*** | ***percentage*** |'
echo '| --- | --- | --- |'
for user in ${!count[@]}
do
  userCount=${count[$user]}
  percent=`echo scale=${bcScale}";" $userCount "*" 100 / $totalCount | bc`"%"
  echo '|' $user '|' ${count[$user]} '|' $percent '|'
done | sort -rnk4   # descending numerically by 4th field = integer count
